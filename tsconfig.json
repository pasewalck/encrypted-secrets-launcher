{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "types",
		"rootDir": "src",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "es2022",
		"skipLibCheck": true,
		"strict": true
	},
	"include": ["src/app.js", "src/secrets.js"]
}
